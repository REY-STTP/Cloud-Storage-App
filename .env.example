# DATABASE — Supabase
# Ambil dari: Project Settings → Database → Connection string
# (session pooler, port 5432)
DATABASE_URL="postgresql://postgres.project-ref-anda:password-anda@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# SMTP EMAIL — Gmail
# Enable 2FA first, then create an App Password at:
# myaccount.google.com → Security → App passwords
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SENDER="<no-reply@yourdomain.com>"

# CLOUDFLARE R2 (object storage for user files)
# Create at: dash.cloudflare.com → R2 Object Storage
# 1. Create a bucket, e.g., "cloud-storage-app"
# 2. Account ID: find on the main Cloudflare dashboard page (on the right)
# 3. API token: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=cloud-storage-app
R2_FOLDER=cloud-storage-app          # optional, folder within the bucket

# Optional: custom public domain for the bucket (e.g., files.domain.com).
# If set, download links will use this URL without pre-signing.
# Leave blank if the bucket remains private (a 1-hour pre-signed link will be used automatically).
R2_PUBLIC_BASE_URL=

# MAX STORAGE
# Max usable storage per user
MAX_STORAGE_BYTES=1073741824 # 1 GB

# ADMIN ACCOUNT
# Initial admin account in supabase
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"

# AUTH
# Generate secret baru di terminal: openssl rand -base64 32
JWT_SECRET=your_auth_secret_here

# BASE URL - the application's public domain (for links in verification/reset emails)
NEXT_PUBLIC_BASE_URL=http://localhost:3000 # your domain
